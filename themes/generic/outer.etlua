<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title or site.title or "" %></title>
<% if path == "404.html" then -%>
<style>
<%- stylesheet -%>
</style>
<% else -%>
<link rel="stylesheet" href="<%= pathToRoot %>style.css" />
<% end -%>
<link rel="icon" href="data:," />
</head>
<body>
<%- content -%>
</body>
</html>

